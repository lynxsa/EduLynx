/*
  LYNXLearn LMS - Enhanced Global Styles
  Modern, responsive design system with advanced animations and effects
  Matching EduLynx application design language
*/

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Nunito:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@300;400;500;600;700&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

/* Dark Mode CSS Variables */
@layer base {
  :root {
    --bg-primary: 255 255 255;
    --bg-secondary: 249 250 251;
    --text-primary: 17 24 39;
    --text-secondary: 107 114 128;
    --border-color: 229 231 235;
    --shadow-color: 0 0 0;

    /* LMS Specific Variables */
    --primary: 147 51 234;
    --primary-foreground: 255 255 255;
    --secondary: 241 245 249;
    --secondary-foreground: 15 23 42;
    --accent: 59 130 246;
    --accent-foreground: 255 255 255;
    --muted: 241 245 249;
    --muted-foreground: 100 116 139;

    /* Card Variables */
    --card: 255 255 255;
    --card-foreground: 15 23 42;
    --border: 226 232 240;
    --input: 226 232 240;
    --ring: 147 51 234;

    /* Gradient Variables */
    --gradient-primary: linear-gradient(135deg, rgb(147, 51, 234) 0%, rgb(59, 130, 246) 100%);
    --gradient-secondary: linear-gradient(135deg, rgb(16, 185, 129) 0%, rgb(101, 163, 13) 100%);
    --gradient-accent: linear-gradient(135deg, rgb(245, 101, 101) 0%, rgb(251, 146, 60) 100%);
  }

  .dark {
    --bg-primary: 17 24 39;
    --bg-secondary: 31 41 55;
    --text-primary: 249 250 251;
    --text-secondary: 156 163 175;
    --border-color: 55 65 81;
    --shadow-color: 0 0 0;

    --primary: 147 51 234;
    --primary-foreground: 255 255 255;
    --secondary: 30 41 59;
    --secondary-foreground: 226 232 240;
    --accent: 59 130 246;
    --accent-foreground: 255 255 255;
    --muted: 30 41 59;
    --muted-foreground: 148 163 184;

    --card: 30 41 59;
    --card-foreground: 226 232 240;
    --border: 51 65 85;
    --input: 51 65 85;
    --ring: 147 51 234;
  }

  * {
    @apply border-border;
  }

  html,
  body {
    max-width: 100vw;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  @media (prefers-color-scheme: dark) {
    html {
      color-scheme: dark;
    }
  }

  body {
    @apply bg-background text-foreground font-inter transition-colors duration-300;
    font-family:
      'Inter',
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      'Helvetica Neue',
      Arial,
      sans-serif;
    background: linear-gradient(135deg, rgb(249, 250, 251) 0%, rgb(243, 244, 246) 100%);
  }

  html {
    scroll-behavior: smooth;
  }
}

/* Enhanced Component Classes for LMS */
@layer components {
  /* Modern Button System */
  .btn-primary {
    @apply bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300 ease-out shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 ring-2 ring-purple-500/20 hover:ring-purple-500/40;
  }

  .btn-secondary {
    @apply bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 font-medium py-3 px-6 rounded-xl transition-all duration-300 ease-out shadow-md hover:shadow-lg hover:scale-105 ring-2 ring-gray-200/20 hover:ring-gray-300/40;
  }

  .btn-accent {
    @apply bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300 ease-out shadow-lg hover:shadow-xl hover:scale-105 active:scale-95;
  }

  /* Advanced Card System */
  .card-modern {
    @apply bg-white backdrop-blur-xl border border-gray-200 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 ease-out hover:scale-[1.02] hover:border-purple-300/50;
  }

  .card-glass {
    @apply bg-white/80 backdrop-blur-xl border border-white/20 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 ease-out hover:scale-[1.02];
  }

  .card-interactive {
    @apply cursor-pointer card-modern hover:shadow-purple-200/25 hover:border-purple-300/50;
  }

  .card-course {
    @apply card-interactive overflow-hidden relative before:absolute before:inset-0 before:bg-gradient-to-r before:from-purple-500/5 before:to-blue-500/5 before:opacity-0 hover:before:opacity-100 before:transition-opacity before:duration-300;
  }

  /* Navigation & Layout */
  .nav-modern {
    @apply bg-white/95 backdrop-blur-xl border-b border-gray-200/50 shadow-lg sticky top-0 z-50;
  }

  .sidebar-modern {
    @apply bg-white/95 backdrop-blur-xl border-r border-gray-200/50 shadow-xl;
  }

  /* Typography System */
  .heading-primary {
    @apply text-4xl md:text-5xl lg:text-6xl font-bold bg-gradient-to-r from-purple-600 via-blue-600 to-indigo-600 bg-clip-text text-transparent leading-tight;
  }

  .heading-secondary {
    @apply text-2xl md:text-3xl font-semibold text-gray-800 leading-tight;
  }

  .heading-card {
    @apply text-lg font-semibold text-gray-900 mb-2;
  }

  .text-muted {
    @apply text-gray-600;
  }

  /* Stats Cards */
  .stat-card {
    @apply bg-gradient-to-br from-white to-gray-50/50 border border-gray-200 rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 relative overflow-hidden;
  }

  .stat-card::before {
    content: '';
    @apply absolute top-0 left-0 w-full h-1 bg-gradient-to-r;
  }

  .stat-card-blue::before {
    @apply from-blue-500 to-blue-600;
  }

  .stat-card-green::before {
    @apply from-emerald-500 to-emerald-600;
  }

  .stat-card-purple::before {
    @apply from-purple-500 to-purple-600;
  }

  .stat-card-orange::before {
    @apply from-orange-500 to-orange-600;
  }

  /* Animations */
  .fade-in {
    animation: fadeIn 0.6s ease-out forwards;
  }

  .slide-up {
    animation: slideUp 0.6s ease-out forwards;
  }

  .float {
    animation: float 6s ease-in-out infinite;
  }

  /* Hero Section */
  .hero-gradient {
    background: linear-gradient(
      135deg,
      rgba(147, 51, 234, 0.1) 0%,
      rgba(59, 130, 246, 0.1) 50%,
      rgba(16, 185, 129, 0.1) 100%
    );
  }

  /* Course Progress */
  .progress-bar {
    @apply w-full bg-gray-200 rounded-full h-2 overflow-hidden;
  }

  .progress-fill {
    @apply h-full bg-gradient-to-r from-purple-500 to-blue-500 transition-all duration-500 ease-out;
  }

  /* Interactive Elements */
  .hover-lift {
    @apply transition-transform duration-300 hover:-translate-y-1 hover:shadow-lg;
  }

  .pulse-ring {
    @apply relative before:absolute before:inset-0 before:rounded-full before:bg-purple-500/20 before:animate-pulse;
  }
}

/* Custom Animations */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-10px);
  }
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

.shimmer {
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  background-size: 200% 100%;
  animation: shimmer 2s infinite;
}

/* Responsive Design Enhancements */
@media (max-width: 768px) {
  .heading-primary {
    @apply text-3xl md:text-4xl;
  }

  .card-modern {
    @apply hover:scale-100;
  }
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  @apply bg-gray-100;
}

::-webkit-scrollbar-thumb {
  @apply bg-gradient-to-b from-purple-400 to-blue-500 rounded-lg;
}

::-webkit-scrollbar-thumb:hover {
  @apply from-purple-500 to-blue-600;
}
