generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id
  username String @unique
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime @default(now())
  classId     Int?
  Class       Class?   @relation(fields: [classId], references: [id])
}

model Answer {
  id          Int         @id @default(autoincrement())
  attemptId   Int
  questionId  Int
  response    String
  isCorrect   Boolean?
  QuizAttempt QuizAttempt @relation(fields: [attemptId], references: [id])
  Question    Question    @relation(fields: [questionId], references: [id])
}

model Assignment {
  id         Int          @id @default(autoincrement())
  title      String
  startDate  DateTime
  dueDate    DateTime
  lessonId   Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  Lesson     Lesson       @relation(fields: [lessonId], references: [id])
  Result     Result[]
  Submission Submission[]
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())
  present   Boolean
  studentId String
  lessonId  Int
  Lesson    Lesson   @relation(fields: [lessonId], references: [id])
  Student   Student  @relation(fields: [studentId], references: [id])
}

model Class {
  id                                  Int            @id @default(autoincrement())
  name                                String         @unique
  capacity                            Int
  supervisorId                        String?
  gradeId                             Int?
  schoolId                            Int?
  createdAt                           DateTime       @default(now())
  updatedAt                           DateTime       @default(now())
  classTeacher                        String?
  roomNumber                          String?
  timetable                           String?
  Announcement                        Announcement[]
  Grade                               Grade?         @relation(fields: [gradeId], references: [id])
  School                              School?        @relation(fields: [schoolId], references: [id])
  Teacher_Class_supervisorIdToTeacher Teacher?       @relation("Class_supervisorIdToTeacher", fields: [supervisorId], references: [id])
  Event                               Event[]
  Lesson                              Lesson[]
  Project                             Project[]
  Student                             Student[]
  Teacher_Teacher_classIdToClass      Teacher[]      @relation("Teacher_classIdToClass")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  classId     Int?
  Class       Class?   @relation(fields: [classId], references: [id])
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime
  lessonId  Int
  Lesson    Lesson   @relation(fields: [lessonId], references: [id])
  Result    Result[]
}

model FinanceEntry {
  id              String      @id
  title           String
  amount          Float
  type            FinanceType
  date            DateTime
  createdAt       DateTime    @default(now())
  category        String?
  linkedParentId  String?
  linkedStudentId String?
  notes           String?
  reference       String?
}

model Grade {
  id       Int       @id @default(autoincrement())
  level    Int       @unique
  schoolId Int?
  Class    Class[]
  School   School?   @relation(fields: [schoolId], references: [id])
  Student  Student[]
}

model Lesson {
  id         Int          @id @default(autoincrement())
  name       String
  day        Day
  startTime  DateTime
  endTime    DateTime
  subjectId  Int
  classId    Int
  teacherId  String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  Assignment Assignment[]
  Attendance Attendance[]
  Exam       Exam[]
  Class      Class        @relation(fields: [classId], references: [id])
  Subject    Subject      @relation(fields: [subjectId], references: [id])
  Teacher    Teacher      @relation(fields: [teacherId], references: [id])
  Quiz       Quiz[]
}

model MedicalRecord {
  id                           String   @id
  studentId                    String   @unique
  bloodType                    String?
  allergies                    String[]
  medications                  String[]
  conditions                   String[]
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  doctorName                   String?
  doctorPhone                  String?
  notes                        String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime
  Student                      Student  @relation(fields: [studentId], references: [id])
}

model Message {
  id                        String          @id
  subject                   String
  content                   String
  preview                   String
  fromId                    String
  toId                      String
  priority                  MessagePriority @default(NORMAL)
  type                      MessageType     @default(INBOX)
  read                      Boolean         @default(false)
  starred                   Boolean         @default(false)
  archived                  Boolean         @default(false)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime
  User_Message_fromIdToUser User            @relation("Message_fromIdToUser", fields: [fromId], references: [id], onDelete: Cascade)
  User_Message_toIdToUser   User            @relation("Message_toIdToUser", fields: [toId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([fromId])
  @@index([toId])
}

model Option {
  id         Int      @id @default(autoincrement())
  questionId Int
  text       String
  Question   Question @relation(fields: [questionId], references: [id])
}

model Parent {
  id                    String    @id
  username              String    @unique
  name                  String
  surname               String
  email                 String    @unique
  phone                 String    @unique
  address               String
  img                   String?
  sex                   UserSex
  createdAt             DateTime  @default(now())
  schoolId              Int?
  userId                String?   @unique
  employer              String?
  occupation            String?
  relationshipToStudent String?
  School                School?   @relation(fields: [schoolId], references: [id])
  User                  User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Student               Student[]
}

model Project {
  id           String        @id
  title        String
  description  String?
  type         ProjectType
  status       ProjectStatus @default(PLANNING)
  startDate    DateTime
  dueDate      DateTime
  grade        Int?
  feedback     String?
  requirements String?
  resources    String?
  subjectId    Int?
  classId      Int?
  teacherId    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  Class        Class?        @relation(fields: [classId], references: [id])
  Subject      Subject?      @relation(fields: [subjectId], references: [id])
  Teacher      Teacher?      @relation(fields: [teacherId], references: [id])
  Student      Student[]     @relation("ProjectStudents")

  @@index([classId])
  @@index([dueDate])
  @@index([status])
  @@index([subjectId])
  @@index([teacherId])
}

model Question {
  id     Int          @id @default(autoincrement())
  quizId Int
  prompt String
  type   QuestionType
  answer String?
  Answer Answer[]
  Option Option[]
  Quiz   Quiz         @relation(fields: [quizId], references: [id])
}

model Quiz {
  id          Int           @id @default(autoincrement())
  title       String
  lessonId    Int
  startDate   DateTime      @default(now())
  endDate     DateTime      @default(now())
  Question    Question[]
  Lesson      Lesson        @relation(fields: [lessonId], references: [id])
  QuizAttempt QuizAttempt[]
}

model QuizAttempt {
  id          Int       @id @default(autoincrement())
  quizId      Int
  studentId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int?
  feedback    String?
  Answer      Answer[]
  Quiz        Quiz      @relation(fields: [quizId], references: [id])
  Student     Student   @relation(fields: [studentId], references: [id])
}

model Result {
  id           Int         @id @default(autoincrement())
  score        Int
  examId       Int?
  assignmentId Int?
  studentId    String
  Assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  Exam         Exam?       @relation(fields: [examId], references: [id])
  Student      Student     @relation(fields: [studentId], references: [id])
}

model School {
  id                 Int       @id @default(autoincrement())
  name               String    @unique
  address            String
  city               String
  province           String
  country            String
  logo               String?
  motto              String?
  principal          String?
  registrationNumber String?
  schoolType         String?
  website            String?
  Class              Class[]
  Grade              Grade[]
  Parent             Parent[]
  Student            Student[]
  Teacher            Teacher[]
  User               User[]
}

model Student {
  id                    String           @id
  username              String           @unique
  name                  String
  surname               String
  email                 String           @unique
  phone                 String           @unique
  address               String
  img                   String?
  bloodType             String
  sex                   UserSex
  createdAt             DateTime         @default(now())
  birthday              DateTime
  parentId              String?
  classId               Int?
  gradeId               Int?
  schoolId              Int?
  userId                String?          @unique
  admissionYear         Int?
  allergies             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  extracurriculars      String?
  gender                String
  guardianRelationship  String?
  homeLanguage          String?
  medicalInfo           String?
  profileImage          String?
  specialNeeds          String?
  status                String?
  Attendance            Attendance[]
  MedicalRecord         MedicalRecord?
  QuizAttempt           QuizAttempt[]
  Result                Result[]
  Class                 Class?           @relation(fields: [classId], references: [id])
  Grade                 Grade?           @relation(fields: [gradeId], references: [id])
  Parent                Parent?          @relation(fields: [parentId], references: [id])
  School                School?          @relation(fields: [schoolId], references: [id])
  User                  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  StudentSubject        StudentSubject[]
  Submission            Submission[]
  Project               Project[]        @relation("ProjectStudents")
}

model StudentSubject {
  id        Int      @id @default(autoincrement())
  studentId String
  subjectId Int
  createdAt DateTime @default(now())
  Student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Subject   Subject  @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId])
}

model Subject {
  id               Int                @id @default(autoincrement())
  name             String             @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now())
  Lesson           Lesson[]
  Project          Project[]
  StudentSubject   StudentSubject[]
  SubjectToTeacher SubjectToTeacher[]
}

model Submission {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  studentId    String
  fileUrl      String?
  text         String?
  submittedAt  DateTime   @default(now())
  grade        Int?
  feedback     String?
  Assignment   Assignment @relation(fields: [assignmentId], references: [id])
  Student      Student    @relation(fields: [studentId], references: [id])
}

model Teacher {
  id                                String             @id
  username                          String             @unique
  name                              String
  surname                           String
  email                             String             @unique
  phone                             String             @unique
  address                           String
  img                               String?
  bloodType                         String
  sex                               UserSex
  createdAt                         DateTime           @default(now())
  birthday                          DateTime
  classId                           Int?
  schoolId                          Int?
  userId                            String?            @unique
  employmentStatus                  String?
  gender                            String?
  idNumber                          String?
  nationality                       String?
  nextOfKinName                     String?
  nextOfKinPhone                    String?
  qualifications                    String?
  yearsExperience                   Int?
  Class_Class_supervisorIdToTeacher Class[]            @relation("Class_supervisorIdToTeacher")
  Lesson                            Lesson[]
  Project                           Project[]
  Class_Teacher_classIdToClass      Class?             @relation("Teacher_classIdToClass", fields: [classId], references: [id])
  School                            School?            @relation(fields: [schoolId], references: [id])
  User                              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  SubjectToTeacher                  SubjectToTeacher[]
}

model User {
  id                           String    @id
  email                        String    @unique
  password                     String?
  firstName                    String
  lastName                     String
  preferredName                String?
  dateOfBirth                  DateTime?
  gender                       String?
  phone                        String?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  province                     String?
  postalCode                   String?
  country                      String    @default("South Africa")
  role                         UserRole
  schoolId                     Int?
  isActive                     Boolean   @default(true)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime
  Message_Message_fromIdToUser Message[] @relation("Message_fromIdToUser")
  Message_Message_toIdToUser   Message[] @relation("Message_toIdToUser")
  Parent                       Parent?
  Student                      Student?
  Teacher                      Teacher?
  School                       School?   @relation(fields: [schoolId], references: [id])
}

model SubjectToTeacher {
  A       Int
  B       String
  Subject Subject @relation(fields: [A], references: [id])
  Teacher Teacher @relation(fields: [B], references: [id])

  @@id([A, B])
  @@map("_SubjectToTeacher")
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum MessageType {
  INBOX
  SENT
  ARCHIVED
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum FinanceType {
  Income
  Expense
}

enum MessagePriority {
  LOW
  NORMAL
  HIGH
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  SUBMITTED
  GRADED
}

enum ProjectType {
  INDIVIDUAL
  GROUP
  CLASS
}

enum UserSex {
  MALE
  FEMALE
}
