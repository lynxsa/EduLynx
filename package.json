{
  "name": "edulynx-ecosystem",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lms": "npm --prefix packages/lynxlearn-lms run dev",
    "dev:services": "concurrently \"npm --prefix packages/curriculum-service run dev\" \"npm --prefix packages/assessment-service run dev\" \"npm --prefix packages/career-service run dev\" \"npm --prefix packages/ai-service run dev\"",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:lms\" \"npm run dev:services\"",
    "build": "next build && turbo run build",
    "start": "next start",
    "test": "turbo run test",
    "lint": "next lint && turbo run lint",
    "type-check": "tsc --noEmit && turbo run type-check",
    "clean": "turbo run clean",
    "reset": "./scripts/reset-caches.sh",
    "seed:curriculum": "npm --prefix packages/curriculum-service run seed",
    "seed:assessment": "npm --prefix packages/assessment-service run seed",
    "seed:career": "npm --prefix packages/career-service run seed",
    "seed:users": "ts-node create-specific-users.ts",
    "seed:all": "npm run seed:curriculum && npm run seed:assessment && npm run seed:career"
  },
